<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/circle_icon_btn"
                    android:text="‹"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Record"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_navy"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AI Noise Cancellation"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/switchNoise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:text="00:00:00"
                android:textColor="@color/text_primary"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRecState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Ready"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.hasan.clearvoice.WaveformView
                android:id="@+id/waveform"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="14dp" />

            <ProgressBar
                android:id="@+id/pbLevel"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/level_meter2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <ToggleButton
                    android:id="@+id/chipAuto"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_mode"
                    android:textColor="@color/chip_text"
                    android:textOff="Auto"
                    android:textOn="Auto"
                    android:textSize="12sp" />

                <ToggleButton
                    android:id="@+id/chipVoice"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_mode"
                    android:textColor="@color/chip_text"
                    android:textOff="Voice Focus"
                    android:textOn="Voice Focus"
                    android:textSize="12sp" />

                <ToggleButton
                    android:id="@+id/chipDeep"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_mode"
                    android:textColor="@color/chip_text"
                    android:textOff="Deep Noise"
                    android:textOn="Deep Noise"
                    android:textSize="12sp" />

                <ToggleButton
                    android:id="@+id/chipMusic"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_mode"
                    android:textColor="@color/chip_text"
                    android:textOff="Music Mode"
                    android:textOn="Music Mode"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDiscard"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/circle_icon_btn"
                    android:enabled="false"
                    android:text="✕"
                    android:textColor="@color/record_red"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btnRecordMain"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="28dp"
                    android:background="@drawable/button_record"
                    android:text="●"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp" />

                <Button
                    android:id="@+id/btnStopSave"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="28dp"
                    android:background="@drawable/circle_icon_btn"
                    android:enabled="false"
                    android:text="■"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRecHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Boro lal button chaple record shuru hobe"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_nav" />
</LinearLayout>
