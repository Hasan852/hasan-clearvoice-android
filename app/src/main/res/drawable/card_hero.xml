<?xml version="1.0" encoding="utf-8"?>
<!-- Hero card for Noise Cancellation: emerald-tinted gradient glass. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="315"
        android:startColor="@color/hero_start"
        android:endColor="@color/hero_end"
        android:type="linear" />
    <stroke android:width="1dp" android:color="@color/accent_dark" />
    <padding android:left="18dp" android:top="16dp" android:right="18dp" android:bottom="16dp" />
</shape>
